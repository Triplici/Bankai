<Bindings>
	<!-- 1.2.1: the game's Key Bindings menu, AddOns: "Toggle Elfcore" (MainKey.lua names it and
	     the header). The game loads this file from the addon's folder by itself: it is not in the TOC.
	     No key is bound here; the player picks one, and the game saves it as any of their bindings. -->
	<Binding name="ELFCORE_TOGGLE" header="ELFCORE" category="ADDONS">
		ElfcoreToggleBinding(keystate)
	</Binding>
</Bindings>
